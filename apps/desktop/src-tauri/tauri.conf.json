{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CantoTranscribe",
  "version": "0.1.0",
  "identifier": "hk.canto.transcribe",
  "build": {
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist",
    "features": ["desktop-app"]
  },
  "app": {
    "windows": [{ "title": "CantoTranscribe", "width": 980, "height": 720, "minWidth": 760, "minHeight": 600 }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'" }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/icon.ico"],
    "resources": [
      "resources/bin/ffmpeg.exe",
      "resources/bin/ffprobe.exe",
      "resources/bin/sherpa-onnx-c-api.dll",
      "resources/bin/onnxruntime.dll",
      "resources/bin/onnxruntime_providers_shared.dll",
      "resources/licenses/sherpa-onnx-LICENSE",
      "resources/licenses/onnxruntime-LICENSE"
    ]
  }
}
